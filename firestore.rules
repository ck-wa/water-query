rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 產品資料為網站公開展示內容；只有登入的公司帳號可新增、修改、刪除。
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // 網站文字設定可公開讀取，修改需登入。
    match /siteSettings/{documentId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}
